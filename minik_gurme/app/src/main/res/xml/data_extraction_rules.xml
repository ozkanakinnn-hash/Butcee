<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ yedekleme ve cihaz aktarımı: bebek kayıtları ve ayarlar dahil (Gizlilik Politikası'nda açıklanmıştır). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="app_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="app_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
