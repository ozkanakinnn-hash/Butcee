rules_version = '2';

// Haber Toplayıcı — Firestore güvenlik kuralları
// - categories / sources / articles: herkes OKUR, kimse uygulamadan YAZAMAZ.
//   (Cloud Function, Admin SDK ile çalıştığı için bu kurallardan etkilenmez.)
// - users/{uid}: yalnızca oturum açmış kullanıcının kendisi okur/yazar.
service cloud.firestore {
  match /databases/{database}/documents {

    match /categories/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /sources/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /articles/{id} {
      allow get: if true;
      // Tek seferde en fazla 50 haber listelenebilir (kötüye kullanım ve maliyet koruması).
      allow list: if request.query.limit <= 50;
      allow write: if false;
    }

    // Futbol: takım listesi ve canlı maç skorları (yalnızca bot yazar)
    match /football_teams/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /matches/{id} {
      allow read: if true;
      allow write: if false;
    }

    // İsimsiz takip sayacı: uygulama takım seçilince +1, bırakılınca −1 yazar (kim takip ediyor bilgisi yok).
    // Sunucu yalnızca takip edilen takımların maçları için canlı skor isteği harcar.
    match /team_follows/{teamId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1
                    && teamId.size() <= 40;
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count is int
                    && request.resource.data.count >= 0
                    && (request.resource.data.count - resource.data.count == 1
                        || request.resource.data.count - resource.data.count == -1);
    }

    // Gönderilen bildirimlerin kaydı (Bildirimler sekmesi) ve piyasa verileri
    match /notifications/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow write: if false;
    }

    // "5 dakikada gündem" (sabah/akşam) ve son depremler: yalnızca sunucu yazar
    match /briefings/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /quakes/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Uzaktan uygulama ayarları (Firebase Console'dan elle düzenlenir)
    match /app_config/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /market/{id} {
      allow read: if true;
      allow write: if false;
    }

    // notify_state, football_meta, app_meta: yalnızca bot (Admin SDK) kullanır; uygulamaya kapalı.

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /user_preferences/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
